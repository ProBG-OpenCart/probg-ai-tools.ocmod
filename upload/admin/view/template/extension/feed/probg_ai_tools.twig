{{ header }}{{ column_left }}

<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-probg-ai-tools" data-toggle="tooltip" title="{{ button_save }}"
                class="btn btn-primary">
          <i class="fa fa-save"></i>
        </button>

        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default">
          <i class="fa fa-reply"></i>
        </a>
      </div>

      <h1>{{ heading_title }}</h1>

      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>

  <div class="container-fluid">

    {% if error_warning %}
      <div class="alert alert-danger alert-dismissible">
        <i class="fa fa-exclamation-circle"></i> {{ error_warning }}
        <button type="button" class="close" data-dismiss="alert">&times;</button>
      </div>
    {% endif %}

    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title">
          <i class="fa fa-cogs"></i> {{ text_edit }}
        </h3>
      </div>

      <div class="panel-body">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-probg-ai-tools"
              class="form-horizontal">

          <ul class="nav nav-tabs">
            <li class="active"><a href="#tab-general" data-toggle="tab">{{ tab_general }}</a></li>
            <li><a href="#tab-ai-sitemap" data-toggle="tab">{{ tab_ai_sitemap }}</a></li>
            <li><a href="#tab-ai-caralog" data-toggle="tab">{{ text_ai_catalog_url }}</a></li>
            <li><a href="#tab-ai-caralog" data-toggle="tab">{{ text_ai_catalog_url }}</a></li>
            <li><a href="#tab-llms" data-toggle="tab">{{ tab_llms }}</a></li>
            <li><a href="#tab-products-graph" data-toggle="tab">{{ tab_products_graph }}</a></li>
            <li><a href="#tab-advanced" data-toggle="tab">{{ tab_advanced }}</a></li>
          </ul>

          <div class="tab-content">

            <!-- GENERAL -->
            <div class="tab-pane active" id="tab-general">

              <div class="form-group">
                <label class="col-sm-2 control-label">
                  <span data-toggle="tooltip" title="{{ help_status }}">{{ entry_status }}</span>
                </label>

                <div class="col-sm-10">
                  <select name="feed_probg_ai_tools_status" class="form-control">
                    <option value="1"
                            {% if feed_probg_ai_tools_status == 1 or feed_probg_ai_tools_status == '1' %}selected{% endif %}>
                      {{ text_enabled }}
                    </option>
                    <option value="0"
                            {% if feed_probg_ai_tools_status == 0 or feed_probg_ai_tools_status == '0' %}selected{% endif %}>
                      {{ text_disabled }}
                    </option>
                  </select>
                </div>
              </div>

              <div class="form-group">
                <label class="col-sm-2 control-label">
                  <span data-toggle="tooltip" title="{{ help_product_limit }}">{{ entry_product_limit }}</span>
                </label>

                <div class="col-sm-10">
                  <input type="number"
                         name="feed_probg_ai_tools_product_limit"
                         value="{{ feed_probg_ai_tools_product_limit }}"
                         class="form-control"
                         min="0"/>
                </div>
              </div>

              <div class="form-group">

                <label class="col-sm-2 control-label">

<span data-toggle="tooltip" title="{{ help_site_description }}">

{{ entry_site_description }}

</span>

                </label>

                <div class="col-sm-10">

<textarea name="feed_probg_ai_tools_site_description"

          rows="4"

          class="form-control">{{ feed_probg_ai_tools_site_description }}</textarea>

                </div>

              </div>


              <div class="form-group">
                <label class="col-sm-2 control-label">
                  <span data-toggle="tooltip" title="{{ help_products }}">{{ entry_products }}</span>
                </label>

                <div class="col-sm-10">
                  <input type="hidden" name="feed_probg_ai_tools_products" value="0"/>
                  <label class="checkbox-inline">
                    <input type="checkbox"
                           name="feed_probg_ai_tools_products"
                           value="1"
                           {% if feed_probg_ai_tools_products %}checked="checked"{% endif %} />
                    {{ text_enabled }}
                  </label>
                </div>
              </div>

              <div class="form-group">
                <label class="col-sm-2 control-label">
                  <span data-toggle="tooltip" title="{{ help_categories }}">{{ entry_categories }}</span>
                </label>

                <div class="col-sm-10">
                  <input type="hidden" name="feed_probg_ai_tools_categories" value="0"/>
                  <label class="checkbox-inline">
                    <input type="checkbox"
                           name="feed_probg_ai_tools_categories"
                           value="1"
                           {% if feed_probg_ai_tools_categories %}checked="checked"{% endif %} />
                    {{ text_enabled }}
                  </label>
                </div>
              </div>

              <div class="form-group">
                <label class="col-sm-2 control-label">
                  <span data-toggle="tooltip" title="{{ help_brands }}">{{ entry_brands }}</span>
                </label>

                <div class="col-sm-10">
                  <input type="hidden" name="feed_probg_ai_tools_brands" value="0"/>
                  <label class="checkbox-inline">
                    <input type="checkbox"
                           name="feed_probg_ai_tools_brands"
                           value="1"
                           {% if feed_probg_ai_tools_brands %}checked="checked"{% endif %} />
                    {{ text_enabled }}
                  </label>
                </div>
              </div>
            </div>
            <!-- AI SITEMAP -->
            <div class="tab-pane" id="tab-ai-sitemap">

              <div class="form-group">
                <label class="col-sm-2 control-label">{{ entry_ai_sitemap_url }}</label>
                <div class="col-sm-10">
                  <input type="text" value="{{ ai_sitemap_url }}" class="form-control" readonly/>
                </div>
              </div>

            </div>

            <!-- AI CATALOG -->
            <div class="tab-pane" id="tab-ai-caralog">
              <div class="form-group">
                <label class="col-sm-2 control-label">
<span data-toggle="tooltip" title="{{ help_ai_catalog }}">
{{ entry_ai_catalog }}
</span>
                </label>

                <div class="col-sm-10">
                  <input type="hidden" name="feed_probg_ai_tools_ai_catalog" value="0"/>

                  <label class="checkbox-inline">
                    <input type="checkbox"
                           name="feed_probg_ai_tools_ai_catalog"
                           value="1"
                           {% if feed_probg_ai_tools_ai_catalog %}checked="checked"{% endif %} />
                    {{ text_enabled }}
                  </label>

                  <input type="text"
                         value="{{ ai_catalog_url }}"
                         class="form-control"
                         readonly
                         style="margin-top:10px;"/>
                </div>
              </div>
            </div>

            <!-- LLMS -->
            <div class="tab-pane" id="tab-llms">

              <div class="form-group">
                <label class="col-sm-2 control-label">{{ entry_llms_txt }}</label>

                <div class="col-sm-10">
                  <input type="hidden" name="feed_probg_ai_tools_llms_txt" value="0"/>
                  <label class="checkbox-inline">
                    <input type="checkbox"
                           name="feed_probg_ai_tools_llms_txt"
                           value="1"
                           {% if feed_probg_ai_tools_llms_txt %}checked="checked"{% endif %} />
                    {{ text_enabled }}
                  </label>

                  <input type="text" value="{{ llms_txt_url }}" class="form-control" readonly style="margin-top:10px;"/>
                </div>
              </div>

              <div class="form-group">
                <label class="col-sm-2 control-label">{{ entry_llms_json }}</label>

                <div class="col-sm-10">
                  <input type="hidden" name="feed_probg_ai_tools_llms_json" value="0"/>
                  <label class="checkbox-inline">
                    <input type="checkbox"
                           name="feed_probg_ai_tools_llms_json"
                           value="1"
                           {% if feed_probg_ai_tools_llms_json %}checked="checked"{% endif %} />
                    {{ text_enabled }}
                  </label>

                  <input type="text" value="{{ llms_json_url }}" class="form-control" readonly
                         style="margin-top:10px;"/>
                </div>
              </div>

              <div class="form-group">
                <label class="col-sm-2 control-label">{{ entry_llms_full }}</label>

                <div class="col-sm-10">
                  <input type="hidden" name="feed_probg_ai_tools_llms_full" value="0"/>
                  <label class="checkbox-inline">
                    <input type="checkbox"
                           name="feed_probg_ai_tools_llms_full"
                           value="1"
                           {% if feed_probg_ai_tools_llms_full %}checked="checked"{% endif %} />
                    {{ text_enabled }}
                  </label>

                  <input type="text" value="{{ llms_full_url }}" class="form-control" readonly
                         style="margin-top:10px;"/>
                </div>
              </div>

            </div>

            <!-- PRODUCTS GRAPH -->
            <div class="tab-pane" id="tab-products-graph">

              <div class="form-group">
                <label class="col-sm-2 control-label">{{ entry_products_graph }}</label>

                <div class="col-sm-10">
                  <input type="hidden" name="feed_probg_ai_tools_products_graph" value="0"/>
                  <label class="checkbox-inline">
                    <input type="checkbox"
                           name="feed_probg_ai_tools_products_graph"
                           value="1"
                           {% if feed_probg_ai_tools_products_graph %}checked="checked"{% endif %} />
                    {{ text_enabled }}
                  </label>

                  <input type="text" value="{{ products_graph_url }}" class="form-control" readonly
                         style="margin-top:10px;"/>
                </div>
              </div>

            </div>

            <!-- ADVANCED -->
            <div class="tab-pane" id="tab-advanced">
              <div class="form-group">
                <label class="col-sm-2 control-label">
<span data-toggle="tooltip" title="{{ help_ai_policy }}">
{{ entry_ai_policy }}
</span>
                </label>

                <div class="col-sm-10">
                  <input type="hidden" name="feed_probg_ai_tools_ai_policy" value="0"/>

                  <label class="checkbox-inline">
                    <input type="checkbox"
                           name="feed_probg_ai_tools_ai_policy"
                           value="1"
                           {% if feed_probg_ai_tools_ai_policy %}checked="checked"{% endif %} />
                    {{ text_enabled }}
                  </label>
                </div>
              </div>

              <div class="form-group">

                <label class="col-sm-2 control-label">

    <span data-toggle="tooltip" title="{{ help_semantic_graph }}">

      {{ entry_semantic_graph }}

    </span>

                </label>

                <div class="col-sm-10">

                  <input type="hidden"
                         name="feed_probg_ai_tools_semantic_graph"
                         value="0" />

                  <label class="checkbox-inline">

                    <input type="checkbox"
                           name="feed_probg_ai_tools_semantic_graph"
                           value="1"
                           {% if feed_probg_ai_tools_semantic_graph %}checked="checked"{% endif %} />

                    {{ text_enabled }}

                  </label>

                  <input type="text"
                         value="{{ semantic_graph_url }}"
                         class="form-control"
                         readonly
                         style="margin-top:10px;" />

                </div>

              </div>

              <!-- SEARCH INDEX -->
              <div class="form-group">
                <label class="col-sm-2 control-label">
<span data-toggle="tooltip" title="{{ help_search_index }}">
{{ entry_search_index }}
</span>
                </label>

                <div class="col-sm-10">
                  <input type="hidden" name="feed_probg_ai_tools_search_index" value="0"/>

                  <label class="checkbox-inline">
                    <input type="checkbox"
                           name="feed_probg_ai_tools_search_index"
                           value="1"
                           {% if feed_probg_ai_tools_search_index %}checked="checked"{% endif %} />
                    {{ text_enabled }}
                  </label>

                  <input type="text"
                         value="{{ search_index_url }}"
                         class="form-control"
                         readonly
                         style="margin-top:10px;"/>
                </div>
              </div>

              <div class="form-group">
                <label class="col-sm-2 control-label">
                  <span data-toggle="tooltip" title="{{ help_htaccess }}">{{ entry_htaccess }}</span>
                </label>

                <div class="col-sm-10">
                  <textarea class="form-control" rows="8" readonly>{{ text_htaccess_rule }}</textarea>
                </div>
              </div>

            </div>

          </div>

        </form>
      </div>
    </div>

  </div>
</div>

{{ footer }}